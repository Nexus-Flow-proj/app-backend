# Application Config
PORT=3001
NODE_ENV=development

# Database Config (Neon / Supabase / Remote Postgres URL)
DATABASE_URL=postgresql://<username>:<password>@<host>/<database>?sslmode=require
# Fallback local/direct connection properties if DATABASE_URL is not used
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=nexus_flow
DB_SSL=false

# JWT Config
JWT_ACCESS_TOKEN_SECRET=your-access-token-secret
JWT_REFRESH_TOKEN_SECRET=your-refresh-token-secret

# Brevo Mail Config (REST API over HTTPS - Works on Railway without port blocking)
# Generate an API key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key
MAIL_FROM=nexusflow.proj@gmail.com
MAIL_FROM_NAME=NexusFlow
FRONTEND_URL=http://localhost:3000

# Throttler Config
THROTTLER_GLOBAL_TTL=900000
THROTTLER_GLOBAL_LIMIT=60
THROTTLER_LOGIN_TTL=900000
THROTTLER_LOGIN_LIMIT=5
THROTTLER_SIGNUP_TTL=900000
THROTTLER_SIGNUP_LIMIT=5
THROTTLER_FORGET_PASSWORD_TTL=900000
THROTTLER_FORGET_PASSWORD_LIMIT=3
THROTTLER_REFRESH_TTL=900000
THROTTLER_REFRESH_LIMIT=10

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# AI / OpenRouter Config
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=google/gemini-2.5-flash
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

# Supabase Config
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe Payments & Billing Config
# Obtain keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Obtain webhook secret from: https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Stripe Product Price IDs (Create Products in Stripe Dashboard > Product Catalog)
STRIPE_PRO_PRICE_ID_MONTHLY=price_1xxxxxxxxxxxxxx
STRIPE_PRO_PRICE_ID_ANNUAL=price_1xxxxxxxxxxxxxx
STRIPE_BUSINESS_PRICE_ID_MONTHLY=price_1xxxxxxxxxxxxxx
STRIPE_BUSINESS_PRICE_ID_ANNUAL=price_1xxxxxxxxxxxxxx

# Stripe Redirect URLs
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/settings/billing
STRIPE_SUCCESS_URL=http://localhost:3000/settings/billing?success=true
STRIPE_CANCEL_URL=http://localhost:3000/settings/billing?canceled=true

