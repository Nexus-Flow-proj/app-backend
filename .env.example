# Application Config
PORT=3001
NODE_ENV=development

# Database Config (Neon / Supabase / Remote Postgres URL)
DATABASE_URL=postgresql://<username>:<password>@<host>/<database>?sslmode=require
# Fallback local/direct connection properties if DATABASE_URL is not used
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=nexus_flow
DB_SSL=false

# JWT Config
JWT_ACCESS_TOKEN_SECRET=your-access-token-secret
JWT_REFRESH_TOKEN_SECRET=your-refresh-token-secret

# Resend / Mailer Config
RESEND_API_KEY=your-resend-api-key
MAIL_FROM=onboarding@resend.dev
FRONTEND_URL=http://localhost:3000

# Throttler Config
THROTTLER_GLOBAL_TTL=900000
THROTTLER_GLOBAL_LIMIT=60
THROTTLER_LOGIN_TTL=900000
THROTTLER_LOGIN_LIMIT=5
THROTTLER_SIGNUP_TTL=900000
THROTTLER_SIGNUP_LIMIT=5
THROTTLER_FORGET_PASSWORD_TTL=900000
THROTTLER_FORGET_PASSWORD_LIMIT=3
THROTTLER_REFRESH_TTL=900000
THROTTLER_REFRESH_LIMIT=10

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# AI / OpenRouter Config
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=google/gemini-2.5-flash
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

# Supabase Config
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
